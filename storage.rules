rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /provider-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /request-photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}