# Base pública de la SPA hacia la que webpayReturn redirige tras procesar.
# - Local (emulador): http://localhost:8081 (o el puerto que uses en `expo start`).
# - Producción: https://<dominio-produccion>
# En producción, definir APP_BASE_URL mediante configuración/secreto de Firebase Functions.
APP_BASE_URL=http://localhost:8081