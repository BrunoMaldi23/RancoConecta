EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Canales de contacto con la administración (número internacional sin +, tel, correo).
# Si se dejan vacíos, la app no muestra botones falsos de contacto.
EXPO_PUBLIC_ADMIN_WHATSAPP=
EXPO_PUBLIC_ADMIN_PHONE=
EXPO_PUBLIC_ADMIN_EMAIL=

# URL externa de pago de membresía para inscribir servicios (portal de pago, Webpay, MercadoPago, etc.).
# Si está vacía, el botón de pago usa WhatsApp/correo de administración configurados arriba.
EXPO_PUBLIC_MEMBERSHIP_URL=

# Base URL de Firebase Cloud Functions (la URL del endpoint NO es un secreto).
# Desarrollo (Functions Emulator):
# http://127.0.0.1:5001/ranco-conecta/southamerica-west1
# Producción: https://southamerica-west1-<proyecto>.cloudfunctions.net
EXPO_PUBLIC_FUNCTIONS_BASE_URL=

# Conecta el cliente a los emuladores locales de Firebase (auth + firestore).
# Solo se aplica en desarrollo (__DEV__) y cuando vale "true". En producción debe quedar vacío/false.
EXPO_PUBLIC_FIREBASE_EMULATOR=false
